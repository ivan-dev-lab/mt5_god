# .env перекрывает значения из config/app.yaml.
# Для обычного переключения режима удобнее менять config/app.yaml.
APP_MODE=dry_run

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_ALLOWED_THREAD_ID=
TELEGRAM_DOWNLOAD_DIR=
TELEGRAM_SEND_STATUS_UPDATES=false
# Оставь пустым для авто-режима:
# - dry_run / analyze_only -> дубликаты разрешены
# - full_pipeline / execute_only -> дубликаты блокируются
TELEGRAM_ALLOW_DUPLICATE_IMAGES=
TELEGRAM_CONNECT_TIMEOUT=20
TELEGRAM_READ_TIMEOUT=60
TELEGRAM_WRITE_TIMEOUT=60
TELEGRAM_POOL_TIMEOUT=20

MT5_TERMINAL_PATH=
TESSERACT_CMD=
